<Window x:Class="ChestTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chest Tracker" Width="1060" Height="800" MinWidth="920" MinHeight="640"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="13" Icon="chest.ico"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" CornerRadius="0"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="RootBorder">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="92"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- ======================================================== sidebar -->
            <Border Grid.RowSpan="2" Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0"/>
            <Image Source="{DynamicResource ChestIcon}" Width="30" Height="30" VerticalAlignment="Bottom" Margin="0,0,0,2"/>

            <StackPanel Grid.Row="1" Margin="0,8,0,0">
                <RadioButton x:Name="NavHome" Style="{StaticResource NavButton}" Tag="&#xE80F;" Content="Home" IsChecked="True" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavStats" Style="{StaticResource NavButton}" Tag="&#xE9D9;" Content="Stats" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavMap" Style="{StaticResource NavButton}" Tag="&#xE707;" Content="Map" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavMatches" Style="{StaticResource NavButton}" Tag="&#xE81C;" Content="Matches" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavFinds" Style="{StaticResource NavButton}" Tag="&#xE734;" Content="Finds" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavTreasure" Style="{StaticResource NavButton}" Tag="&#xE7C1;" Content="Treasure" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavOdds" Style="{StaticResource NavButton}" Tag="&#xE8EF;" Content="Odds" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavSquad" Style="{StaticResource NavButton}" Tag="&#xE716;" Content="Squad" Checked="Nav_Checked" Visibility="Collapsed"/>
                <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" Tag="&#xE713;" Content="Settings" Checked="Nav_Checked"/>
            </StackPanel>
            <TextBlock x:Name="VersionText" Grid.Row="1" Text="v2.0" Foreground="{DynamicResource TextFaint}" FontSize="11"
                       HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16"/>

            <!-- ======================================================== title bar -->
            <Grid Grid.Column="1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="28,4,0,0">
                    <TextBlock Text="Chest Tracker" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock Text="  ·  Pirate Token odds" FontSize="13" Foreground="{DynamicResource TextFaint}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource ChromeButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimize"/>
                    <Button x:Name="MaxButton" Style="{StaticResource ChromeButton}" Content="&#xE922;" Click="Maximize_Click" ToolTip="Maximize"/>
                    <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Close"/>
                </StackPanel>
            </Grid>

            <!-- ======================================================== pages -->
            <Grid Grid.Row="1" Grid.Column="1">

                <!-- ==================================================== HOME -->
                <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,6,28,28">
                        <Grid Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Your treasure hunt" Style="{StaticResource PageTitle}"/>
                                <TextBlock Text="Every chest is a 1 in 137,500 shot at the Pirate Shop Access token."
                                           Style="{StaticResource Hint}" FontSize="13" Margin="0,5,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Border CornerRadius="18" Padding="14,8" Background="{DynamicResource Surface}"
                                        BorderBrush="{DynamicResource Line}" BorderThickness="1" Margin="0,0,12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="{DynamicResource TextFaint}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="StatusText" Text="Not tracking" Margin="9,0,0,0" FontSize="12.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" Click="Start_Click" MinWidth="164">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="StartIcon" FontFamily="{StaticResource IconFont}" Text="&#xE768;" VerticalAlignment="Center" FontSize="12"/>
                                        <TextBlock x:Name="StartLabel" Text="Start tracking" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Border x:Name="ErrorBanner" Visibility="Collapsed" CornerRadius="12" Padding="16,12" Margin="0,0,0,16"
                                Background="#22FF5D5D" BorderBrush="#55FF5D5D" BorderThickness="1">
                            <TextBlock x:Name="ErrorText" Foreground="#FFB0B0" TextWrapping="Wrap"/>
                        </Border>
                        <Border x:Name="WarningBanner" Visibility="Collapsed" CornerRadius="12" Padding="16,12" Margin="0,0,0,16"
                                Background="#22FF9A3C" BorderBrush="#55FF9A3C" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7BA;" Foreground="{StaticResource Orange}" VerticalAlignment="Top" Margin="0,2,10,0"/>
                                <TextBlock x:Name="WarningText" Foreground="#FFD2A8" TextWrapping="Wrap" MaxWidth="820"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="UpdateBanner" Visibility="Collapsed" CornerRadius="12" Padding="16,10" Margin="0,0,0,16"
                                Background="#224C9CFF" BorderBrush="#554C9CFF" BorderThickness="1">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE896;" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="UpdateText" Foreground="#CFE3FF" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button Style="{StaticResource SecondaryButton}" Content="Download" HorizontalAlignment="Right" Click="Update_Click"/>
                            </Grid>
                        </Border>

                        <!-- row 1: count + chance -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="11*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="9*"/>
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource HeroCard}" Padding="26,22">
                                <Grid>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{DynamicResource ChestIcon}" Width="16" Height="16"/>
                                            <TextBlock Text="CHESTS OPENED" Style="{StaticResource Label}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="CountText" Text="0" FontSize="84" FontWeight="Bold" Margin="-3,2,0,0"/>
                                        <TextBlock x:Name="SquadHomeText" Text="" Foreground="{DynamicResource Gold}" FontSize="14" FontWeight="SemiBold"
                                                   Margin="0,-4,0,6" Visibility="Collapsed"/>
                                        <TextBlock x:Name="BreakdownText" Text="0 normal · 0 in Treasure Hours" Style="{StaticResource Hint}" FontSize="13"/>
                                        <TextBlock x:Name="TodayText" Text="0 today" Foreground="{DynamicResource Gold}" FontSize="13" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="SessionHomeText" Text="" Style="{StaticResource Hint}" FontSize="13" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource SecondaryButton}" Click="Undo_Click" ToolTip="Undo the last chest (F8)">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7A7;" VerticalAlignment="Center"/>
                                                <TextBlock Text="Undo" Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource SecondaryButton}" Click="Add_Click" Margin="8,0,0,0" ToolTip="Add a chest it missed (F7)">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE710;" VerticalAlignment="Center"/>
                                                <TextBlock Text="Add chest" Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="26,22">
                                <StackPanel>
                                    <TextBlock Text="PIRATE TOKEN CHANCE" Style="{StaticResource Label}"/>
                                    <TextBlock x:Name="ChanceText" Text="0%" FontSize="46" FontWeight="Bold" Foreground="{DynamicResource Gold}" Margin="-2,8,0,0"/>
                                    <TextBlock x:Name="OneInText" Text="No chests yet" Style="{StaticResource Hint}" FontSize="13"/>
                                    <Grid Margin="0,26,0,8">
                                        <TextBlock Text="Progress to a 50% chance" FontSize="12.5" Foreground="{DynamicResource TextDim}"/>
                                        <TextBlock x:Name="ProgressText" Text="0%" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <ProgressBar x:Name="HalfProgress" Style="{StaticResource GoldProgress}" Maximum="1" Value="0"/>
                                    <TextBlock x:Name="RemainingText" Text="95,308 chests to go" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
                                    <TextBlock Text="It's luck, not a countdown: no number of chests guarantees the token."
                                               Style="{StaticResource Hint}" FontSize="11.5" Foreground="{DynamicResource TextFaint}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- row 2: controls + recent -->
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="9*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="11*"/>
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Controls" Style="{StaticResource CardTitle}" Margin="0,0,0,14"/>
                                    <CheckBox x:Name="TreasureSwitch" Style="{StaticResource Switch}" Click="TreasureSwitch_Click">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Treasure Hours" FontWeight="SemiBold"/>
                                                <Border Background="{StaticResource OrangeSoft}" CornerRadius="5" Padding="6,1" Margin="8,0,0,0">
                                                    <TextBlock x:Name="BoostText" Text="1.5x" Foreground="{StaticResource Orange}" FontSize="11" FontWeight="SemiBold"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock x:Name="TreasureHint" Text="Turn on during Saturday Treasure Hours · F9" Style="{StaticResource Hint}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </CheckBox>
                                    <Border Style="{StaticResource Divider}"/>
                                    <CheckBox x:Name="OverlaySwitch" Style="{StaticResource Switch}" Click="OverlaySwitch_Click">
                                        <StackPanel>
                                            <TextBlock Text="Overlay" FontWeight="SemiBold"/>
                                            <TextBlock Text="Shows your count on top of Fortnite" Style="{StaticResource Hint}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </CheckBox>
                                    <Border Style="{StaticResource Divider}"/>
                                    <CheckBox x:Name="LockSwitch" Style="{StaticResource Switch}" Click="LockSwitch_Click">
                                        <StackPanel>
                                            <TextBlock Text="Lock overlay" FontWeight="SemiBold"/>
                                            <TextBlock Text="Clicks pass through it · F6 · always on while you play" Style="{StaticResource Hint}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </CheckBox>
                                    <Border Style="{StaticResource Divider}"/>
                                    <TextBlock Text="Been counting already?" FontWeight="SemiBold"/>
                                    <TextBlock Text="Type how many chests you opened before using Chest Tracker (counted by hand or with another tracker) and press Add. It's added on top of what the tracker counts, and replays never change it."
                                               Style="{StaticResource Hint}" Margin="0,3,0,10" TextWrapping="Wrap"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="AlreadyOpenedBox" Style="{StaticResource Input}" Text="" MaxLength="9"
                                                 PreviewTextInput="Digits_PreviewTextInput" DataObject.Pasting="Digits_Pasting"
                                                 KeyDown="AlreadyOpenedBox_KeyDown" TextChanged="AlreadyOpenedBox_TextChanged"
                                                 ToolTip="Number of chests, e.g. 250"/>
                                        <TextBlock x:Name="AlreadyOpenedPlaceholder" Text="e.g. 250" IsHitTestVisible="False" FontSize="14"
                                                   Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center" Margin="13,0,0,0"/>
                                        <Button x:Name="AlreadyOpenedButton" Grid.Column="1" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                                                Click="AddAlreadyOpened_Click" IsEnabled="False" Padding="16,9">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE710;" VerticalAlignment="Center" FontSize="11"/>
                                                <TextBlock Text="Add" Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <CheckBox x:Name="AlreadyOpenedTreasure" Style="{StaticResource Switch}" Margin="0,10,0,0">
                                        <TextBlock Text="These were opened in Treasure Hours (1.5x odds)" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                                    </CheckBox>
                                    <TextBlock x:Name="AlreadyOpenedResult" Style="{StaticResource Hint}" Margin="0,8,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Recent chests" Style="{StaticResource CardTitle}" Margin="0,0,0,14"/>
                                    <TextBlock x:Name="RecentEmpty" Grid.Row="1" Style="{StaticResource Hint}" FontSize="13"
                                               Text="Chests you open will show up here. Start tracking, then hop into a match."
                                               VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="280"/>
                                    <ItemsControl x:Name="RecentList" Grid.Row="1">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource Surface2}">
                                                        <Image Source="{DynamicResource ChestIcon}" Width="17" Height="17"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Detail}" FontSize="11.5" Foreground="{DynamicResource TextDim}" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="2" CornerRadius="6" Padding="7,2" Background="{StaticResource OrangeSoft}"
                                                            Visibility="{Binding TreasureVisibility}" VerticalAlignment="Center">
                                                        <TextBlock Text="Treasure Hours" FontSize="10.5" Foreground="{StaticResource Orange}" FontWeight="SemiBold"/>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>
                        </Grid>

                        <TextBlock Margin="2,18,0,0" Style="{StaticResource Hint}"
                                   Text="Chests are added a few seconds after each match ends.   F6 move/lock overlay   ·   F7 add a missed chest   ·   F8 undo   ·   F9 Treasure Hours"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- ==================================================== STATS -->
                <ScrollViewer x:Name="StatsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,6,28,28">
                        <TextBlock Text="Your stats" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Worked out from the chests in your count. Matches come from their replays."
                                   Style="{StaticResource Hint}" FontSize="13" Margin="0,5,0,20"/>

                        <UniformGrid Columns="4">
                            <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="MATCHES COUNTED" Style="{StaticResource Label}"/>
                                    <TextBlock x:Name="StatMatches" Text="0" FontSize="30" FontWeight="Bold" Margin="0,6,0,0"/>
                                    <TextBlock x:Name="StatMatchesHint" Text="" Style="{StaticResource Hint}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="4,0,4,0">
                                <StackPanel>
                                    <TextBlock Text="CHESTS PER MATCH" Style="{StaticResource Label}"/>
                                    <TextBlock x:Name="StatPerMatch" Text="0" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource Gold}" Margin="0,6,0,0"/>
                                    <TextBlock Text="on average" Style="{StaticResource Hint}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="4,0,4,0">
                                <StackPanel>
                                    <TextBlock Text="BEST MATCH" Style="{StaticResource Label}"/>
                                    <TextBlock x:Name="StatBest" Text="0" FontSize="30" FontWeight="Bold" Margin="0,6,0,0"/>
                                    <TextBlock x:Name="StatBestHint" Text="" Style="{StaticResource Hint}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="THIS WEEK" Style="{StaticResource Label}"/>
                                    <TextBlock x:Name="StatWeek" Text="0" FontSize="30" FontWeight="Bold" Margin="0,6,0,0"/>
                                    <TextBlock x:Name="StatToday" Text="0 today" Style="{StaticResource Hint}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Chests per day (last 14 days)" Style="{StaticResource CardTitle}" Margin="0,0,0,14"/>
                                <ItemsControl x:Name="DayBars" Height="150">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="4,0" ToolTip="{Binding Tip}">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="{Binding Value}" FontSize="10.5" Foreground="{DynamicResource TextDim}" HorizontalAlignment="Center"/>
                                                <Border Grid.Row="1" VerticalAlignment="Bottom" Height="{Binding BarHeight}" CornerRadius="4,4,0,0"
                                                        Background="{Binding Brush}" Margin="2,2,2,0"/>
                                                <TextBlock Grid.Row="2" Text="{Binding Label}" FontSize="10.5" Foreground="{DynamicResource TextFaint}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="How fast you find chests" Style="{StaticResource CardTitle}"/>
                                <TextBlock Text="From your match replays. &quot;Landing&quot; is your first chest of the match."
                                           Style="{StaticResource Hint}" Margin="0,4,0,14"/>
                                <UniformGrid Columns="3" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="FIRST CHEST" Style="{StaticResource Label}"/>
                                        <TextBlock x:Name="EffFirst" Text="–" FontSize="24" FontWeight="Bold" Margin="0,4,0,0"/>
                                        <TextBlock Text="after the match starts (warm-up and bus included)" Style="{StaticResource Hint}" FontSize="11" TextWrapping="Wrap" Margin="0,0,12,0"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="FIRST 5 MINUTES" Style="{StaticResource Label}"/>
                                        <TextBlock x:Name="EffFive" Text="–" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource Gold}" Margin="0,4,0,0"/>
                                        <TextBlock Text="chests in the 5 minutes after landing" Style="{StaticResource Hint}" FontSize="11" TextWrapping="Wrap" Margin="0,0,12,0"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="CHESTS PER MINUTE" Style="{StaticResource Label}"/>
                                        <TextBlock x:Name="EffRate" Text="–" FontSize="24" FontWeight="Bold" Margin="0,4,0,0"/>
                                        <TextBlock Text="from your first chest to your last" Style="{StaticResource Hint}" FontSize="11" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </UniformGrid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="LANDING SPOT" Style="{StaticResource Label}"/>
                                    <TextBlock Grid.Column="1" Text="MATCHES" Style="{StaticResource Label}"/>
                                    <TextBlock Grid.Column="2" Text="FIRST 5 MIN" Style="{StaticResource Label}"/>
                                    <TextBlock Grid.Column="3" Text="PER MINUTE" Style="{StaticResource Label}"/>
                                </Grid>
                                <TextBlock x:Name="EffEmpty" Text="Shows up after a few matches (place names need the internet once)." Style="{StaticResource Hint}"/>
                                <ItemsControl x:Name="EffList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="110"/>
                                                        <ColumnDefinition Width="110"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Matches}" FontSize="12.5" Foreground="{DynamicResource TextDim}"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Five}" FontSize="12.5"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding Rate}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Gold}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Chest types" Style="{StaticResource CardTitle}" Margin="0,0,0,14"/>
                                    <TextBlock x:Name="KindsEmpty" Text="Shows up after your first counted match." Style="{StaticResource Hint}"/>
                                    <ItemsControl x:Name="KindList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="150"/>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition Width="60"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" FontSize="12.5"/>
                                                    <ProgressBar Grid.Column="1" Style="{StaticResource GoldProgress}" Maximum="1" Value="{Binding Share, Mode=OneWay}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Count}" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="How your chests were counted" Style="{StaticResource CardTitle}" Margin="0,0,0,14"/>
                                    <ItemsControl x:Name="SourceList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,10">
                                                    <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="{DynamicResource TextDim}"/>
                                                    <TextBlock Text="{Binding Count}" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- ==================================================== MAP -->
                <Grid x:Name="MapPage" Visibility="Collapsed" Margin="28,6,28,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.ColumnSpan="3" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Chest map" Style="{StaticResource PageTitle}"/>
                            <TextBlock x:Name="MapSubtitle" Text="Every chest you opened this season, from your match replays." Style="{StaticResource Hint}" FontSize="13" Margin="0,5,0,0"/>
                        </StackPanel>
                        <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="MapAll" Style="{StaticResource Segment}" GroupName="map" Content="Season" IsChecked="True" Checked="MapFilter_Checked"/>
                                <RadioButton x:Name="MapWeek" Style="{StaticResource Segment}" GroupName="map" Content="7 days" Checked="MapFilter_Checked"/>
                                <RadioButton x:Name="MapToday" Style="{StaticResource Segment}" GroupName="map" Content="Today" Checked="MapFilter_Checked"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8" ClipToBounds="True">
                        <Grid>
                            <Viewbox Stretch="Uniform">
                                <Grid x:Name="MapSurface" Width="1000" Height="1000">
                                    <Image x:Name="MapImage" Stretch="Fill"/>
                                    <Canvas x:Name="MapDots"/>
                                </Grid>
                            </Viewbox>
                            <TextBlock x:Name="MapMessage" Style="{StaticResource Hint}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360" Visibility="Collapsed"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Best landing spots" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Text="Where your first chest of each match was, and how many chests those matches gave you on average."
                                               Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,12"/>
                                    <TextBlock x:Name="SpotsEmpty" Text="Play a few matches to see your best spots." Style="{StaticResource Hint}" TextWrapping="Wrap"/>
                                    <ItemsControl x:Name="SpotList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,9">
                                                    <Grid>
                                                        <StackPanel Margin="0,0,50,0">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Hint}" FontSize="11.5" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Avg}" Foreground="{DynamicResource Gold}" FontWeight="Bold" FontSize="16"
                                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="Key" Style="{StaticResource CardTitle}" Margin="0,0,0,10"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Ellipse Width="10" Height="10" Fill="{DynamicResource Gold}" Stroke="#AA000000" StrokeThickness="1"/>
                                        <TextBlock Text="Chest you opened" Style="{StaticResource Hint}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Ellipse Width="10" Height="10" Fill="{StaticResource Orange}" Stroke="#AA000000" StrokeThickness="1"/>
                                        <TextBlock Text="Chest you broke open" Style="{StaticResource Hint}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="10" Height="10" Fill="#B57BFF" Stroke="#AA000000" StrokeThickness="1"/>
                                        <TextBlock Text="Sprite chest" Style="{StaticResource Hint}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock x:Name="MapCountText" Style="{StaticResource Hint}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                                    <TextBlock Text="Map picture and place names: fortnite-api.com." Style="{StaticResource Hint}" FontSize="11" Foreground="{DynamicResource TextFaint}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ==================================================== TREASURE (info from fortnite.bot) -->
                <ScrollViewer x:Name="TreasurePage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,6,28,28">
                        <TextBlock Text="Treasure Hunters" Style="{StaticResource PageTitle}"/>
                        <TextBlock x:Name="TreasureSource" Text="Treasure Hours, odds and prizes. Info from fortnite.bot."
                                   Style="{StaticResource Hint}" FontSize="13" Margin="0,5,0,20"/>

                        <Border Style="{StaticResource HeroCard}">
                            <Grid>
                                <StackPanel>
                                    <TextBlock x:Name="NextHourLabel" Text="NEXT TREASURE HOUR" Style="{StaticResource Label}"/>
                                    <TextBlock x:Name="NextHourCountdown" Text="--" FontSize="44" FontWeight="Bold" Foreground="{DynamicResource Gold}" Margin="-2,6,0,0"/>
                                    <TextBlock x:Name="NextHourWhen" Text="" Style="{StaticResource Hint}" FontSize="13"/>
                                </StackPanel>
                                <StackPanel x:Name="NextHourBoosts" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Prize odds per chest" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Text="Your chance uses the chests in your count. Weekly prizes change every week, so only this week's chests count for them."
                                               Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,12"/>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="PRIZE" Style="{StaticResource Label}"/>
                                        <TextBlock Grid.Column="1" Text="PER CHEST" Style="{StaticResource Label}"/>
                                        <TextBlock Grid.Column="2" Text="YOUR CHANCE" Style="{StaticResource Label}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <ItemsControl x:Name="PrizeList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,9">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition/>
                                                            <ColumnDefinition Width="100"/>
                                                            <ColumnDefinition Width="80"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5"/>
                                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Hint}" FontSize="11"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding OneIn}" FontSize="12.5" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding Chance}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Gold}"
                                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="EpicNote" Style="{StaticResource Hint}" FontSize="11.5" TextWrapping="Wrap" Margin="0,10,0,0" FontStyle="Italic"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Treasure Hours" Style="{StaticResource CardTitle}"/>
                                    <TextBlock x:Name="HoursHint" Text="In your time zone. Chests opened in these hours get the boost automatically."
                                               Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,12"/>
                                    <ItemsControl x:Name="HourList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,8" Opacity="{Binding Fade}">
                                                    <Grid>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding When}" FontWeight="SemiBold" FontSize="12.5"/>
                                                            <TextBlock Text="{Binding Boosts}" Style="{StaticResource Hint}" FontSize="11"/>
                                                        </StackPanel>
                                                        <Border CornerRadius="6" Padding="7,2" Background="{Binding TagBack}" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Tag}" FontSize="10.5" FontWeight="SemiBold" Foreground="{Binding TagFore}"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Weekly prizes" Style="{StaticResource CardTitle}" Margin="0,0,0,12"/>
                                <ItemsControl x:Name="WeekList">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Columns="5"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource Surface2}" CornerRadius="12" Padding="12" Margin="0,0,8,0"
                                                    BorderBrush="{Binding Edge}" BorderThickness="1" Opacity="{Binding Fade}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Header}" Style="{StaticResource Label}" FontSize="10"/>
                                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13" Margin="0,4,0,2" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding State}" Foreground="{DynamicResource Gold}" FontSize="11" Margin="0,0,0,8"/>
                                                    <TextBlock Text="{Binding Prizes}" Style="{StaticResource Hint}" FontSize="11.5" TextWrapping="Wrap" LineHeight="17"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Every week also has gizmos: Extraction Accelerator, Portable Extractor, Sprite Locator, Lucky Locator and Golden Firework."
                                           Style="{StaticResource Hint}" FontSize="11.5" TextWrapping="Wrap" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Fortnite server status" Style="{StaticResource CardTitle}"/>
                                        <TextBlock x:Name="StatusSource" Text="From Epic's public status page." Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Border x:Name="StatusPill" CornerRadius="10" Padding="10,4" Background="#223DDC84" Margin="0,0,10,0">
                                            <TextBlock x:Name="StatusOverall" Text="Checking…" FontWeight="SemiBold" Foreground="{StaticResource Green}"/>
                                        </Border>
                                        <Button Style="{StaticResource SecondaryButton}" Content="Refresh" Click="RefreshStatus_Click"/>
                                    </StackPanel>
                                </Grid>
                                <ItemsControl x:Name="StatusNotices">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="10" Padding="12,8" Margin="0,0,0,8" Background="#22FF9A3C">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Hint}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl x:Name="StatusParts">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,16,8">
                                                <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="{DynamicResource TextDim}"/>
                                                <TextBlock Text="{Binding Status}" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ==================================================== MATCHES -->
                <Grid x:Name="MatchesPage" Visibility="Collapsed" Margin="28,6,28,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="330"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,16">
                        <TextBlock Text="Match history" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Pick a match to see your route: its chests on the map, numbered in the order you opened them."
                                   Style="{StaticResource Hint}" FontSize="13" Margin="0,5,0,0"/>
                    </StackPanel>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10">
                        <Grid>
                            <TextBlock x:Name="MatchHistoryEmpty" Text="Matches show up here after they end." Style="{StaticResource Hint}"
                                       Margin="10" TextWrapping="Wrap" Visibility="Collapsed"/>
                            <ListBox x:Name="MatchHistoryList" Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="MatchHistory_SelectionChanged">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="bd" CornerRadius="10" Padding="12,9" Margin="0,0,0,4" Background="Transparent">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#0FFFFFFF"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Surface2}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <StackPanel Margin="0,0,56,0">
                                                <TextBlock Text="{Binding When}" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource Text}"/>
                                                <TextBlock Text="{Binding Detail}" FontSize="11.5" Foreground="{DynamicResource TextDim}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Chests}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Gold}" HorizontalAlignment="Right"/>
                                                <TextBlock Text="chests" FontSize="10.5" Foreground="{DynamicResource TextFaint}" HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12">
                            <UniformGrid Columns="4">
                                <StackPanel>
                                    <TextBlock Text="PLACED" Style="{StaticResource Label}"/>
                                    <TextBlock x:Name="MatchPlaced" Text="–" FontSize="20" FontWeight="Bold" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="ELIMINATIONS" Style="{StaticResource Label}"/>
                                    <TextBlock x:Name="MatchElims" Text="–" FontSize="20" FontWeight="Bold" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="CHESTS" Style="{StaticResource Label}"/>
                                    <TextBlock x:Name="MatchChests" Text="–" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Gold}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="LENGTH" Style="{StaticResource Label}"/>
                                    <TextBlock x:Name="MatchLength" Text="–" FontSize="20" FontWeight="Bold" Margin="0,4,0,0"/>
                                </StackPanel>
                            </UniformGrid>
                        </Border>
                        <Border x:Name="PrizesBox" Grid.Row="1" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="GOLDEN CHEST PRIZES IN THIS MATCH" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="PrizesText" Margin="0,6,0,0" TextWrapping="Wrap" FontSize="12.5"/>
                                <TextBlock Text="Only prizes found near you show up: your replay doesn't see the rest of the island. A token found far away won't be here."
                                           Style="{StaticResource Hint}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="RouteBox" Grid.Row="2" Style="{StaticResource Card}" Padding="8" ClipToBounds="True">
                            <Grid>
                                <Viewbox Stretch="Uniform">
                                    <Grid Width="1000" Height="1000">
                                        <Image x:Name="RouteImage" Stretch="Fill"/>
                                        <Canvas x:Name="RouteCanvas"/>
                                    </Grid>
                                </Viewbox>
                                <TextBlock x:Name="RouteMessage" Style="{StaticResource Hint}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ==================================================== FINDS -->
                <ScrollViewer x:Name="FindsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,6,28,28">
                        <TextBlock Text="Your finds" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Treasure Hunters prizes you've found. The tracker adds them from your replays; add anything it missed by hand."
                                   Style="{StaticResource Hint}" FontSize="13" Margin="0,5,0,20"/>

                        <UniformGrid Columns="3" Margin="0,0,0,16">
                            <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="FOUND" Style="{StaticResource Label}"/>
                                    <TextBlock x:Name="FindsTotal" Text="0" FontSize="30" FontWeight="Bold" Margin="0,6,0,0"/>
                                    <TextBlock x:Name="FindsTotalHint" Text="" Style="{StaticResource Hint}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="4,0,4,0">
                                <StackPanel>
                                    <TextBlock Text="COSMETICS" Style="{StaticResource Label}"/>
                                    <TextBlock x:Name="FindsCosmetics" Text="0" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource Gold}" Margin="0,6,0,0"/>
                                    <TextBlock Text="outfits, pickaxes, decals, tracks…" Style="{StaticResource Hint}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="PIRATE SHOP ACCESS" Style="{StaticResource Label}"/>
                                    <TextBlock x:Name="FindsToken" Text="Not yet" FontSize="30" FontWeight="Bold" Margin="0,6,0,0"/>
                                    <TextBlock x:Name="FindsTokenHint" Text="keep going" Style="{StaticResource Hint}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Everything you've found" Style="{StaticResource CardTitle}" Margin="0,0,0,12"/>
                                <TextBlock x:Name="FindsEmpty" Text="Nothing yet. Prizes you find show up here after the match." Style="{StaticResource Hint}"/>
                                <ItemsControl x:Name="FindsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource Surface2}">
                                                        <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="{DynamicResource Gold}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Hint}" FontSize="11.5" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource SecondaryButton}" Content="Change" Tag="{Binding Id}" Click="FindEdit_Click" Padding="12,6" Margin="0,0,6,0"/>
                                                        <Button Style="{StaticResource SecondaryButton}" Content="Remove" Tag="{Binding Id}" Click="FindRemove_Click" Padding="12,6"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock x:Name="FindFormTitle" Text="Add something the tracker didn't pick up" Style="{StaticResource CardTitle}"/>
                                <TextBlock Text="For prizes you found before you had Chest Tracker (or in a match whose replay is gone). Pick it from the list, or choose &quot;Something else&quot; and type its name."
                                           Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,12"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="1.4*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="WHAT DID YOU FIND?" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="FindPick" SelectionChanged="FindPick_SelectionChanged" Height="38" FontSize="13"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="WHEN" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="FindWhen" Height="38" FontSize="13"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom">
                                        <Button x:Name="FindCancel" Style="{StaticResource SecondaryButton}" Content="Cancel" Click="FindCancel_Click" Margin="0,0,8,0" Visibility="Collapsed"/>
                                        <Button x:Name="FindAddButton" Style="{StaticResource PrimaryButton}" Content="Add" Click="FindAdd_Click" Padding="18,9"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel x:Name="FindCustomRow" Margin="0,10,0,0" Visibility="Collapsed">
                                    <TextBlock Text="NAME" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                                    <TextBox x:Name="FindCustomName" Style="{StaticResource Input}" MaxLength="80"/>
                                </StackPanel>
                                <TextBlock x:Name="FindResult" Style="{StaticResource Hint}" Margin="0,8,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ==================================================== SQUAD -->
                <ScrollViewer x:Name="SquadPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,6,28,28">
                        <TextBlock Text="Squad" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Everyone you've played with, how many chests they opened and what they found."
                                   Style="{StaticResource Hint}" FontSize="13" Margin="0,5,0,20"/>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="SquadTrackSwitch" Style="{StaticResource Switch}" Click="SquadTrackSwitch_Click">
                                    <StackPanel>
                                        <TextBlock Text="Track my squad" FontWeight="SemiBold"/>
                                        <TextBlock Text="Remembers each teammate's name, their chests and any prize they found, from your match replays. Matches Fortnite still has replays of are added too."
                                                   Style="{StaticResource Hint}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </CheckBox>
                                <Border Style="{StaticResource Divider}"/>
                                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8"
                                           Text="FRIEND means they queued with you in your party (fills are RANDOM). Fortnite doesn't save your friends list on your PC, so press &quot;Mark as friend&quot; for anyone it got wrong."/>
                                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" FontSize="12"
                                           Text="Your replay only sees what happens near you, so a teammate who drops somewhere else won't have all their chests here. Their real totals are usually higher. Squad totals never change your own count or odds."/>
                                <TextBlock x:Name="SquadStatus" Style="{StaticResource Hint}" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                                <Border Style="{StaticResource Divider}"/>
                                <CheckBox x:Name="SquadTotalSwitch" Style="{StaticResource Switch}" Click="SquadTotalSwitch_Click">
                                    <StackPanel>
                                        <TextBlock Text="Add my squad to my total" FontWeight="SemiBold"/>
                                        <TextBlock Text="Shows &quot;with your squad&quot; (your chests plus your teammates') just under your count, on the overlay and on Home. Your own count and odds stay the same."
                                                   Style="{StaticResource Hint}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="Teammates" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                                    <Button Style="{StaticResource SecondaryButton}" Content="Clear list" HorizontalAlignment="Right" Click="SquadClear_Click" Padding="12,6"/>
                                </Grid>
                                <TextBlock x:Name="SquadEmpty" Text="Turn on squad tracking and play with friends. They'll show up here." Style="{StaticResource Hint}" TextWrapping="Wrap"/>
                                <ItemsControl x:Name="SquadList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,11">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center"/>
                                                            <Border CornerRadius="6" Padding="7,1" Margin="8,0,0,0" Background="{Binding BadgeBack}" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Badge}" FontSize="10.5" FontWeight="SemiBold" Foreground="{Binding BadgeFore}"/>
                                                            </Border>
                                                            <Button Style="{StaticResource LinkButton}" Content="{Binding FriendAction}" Tag="{Binding Key}" Click="SquadFriend_Click"
                                                                    FontSize="11.5" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Hint}" FontSize="11.5" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding Kinds}" Style="{StaticResource Hint}" FontSize="11.5" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding Finds}" Foreground="{DynamicResource Gold}" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap"
                                                                   Visibility="{Binding FindsVisibility}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                                                        <TextBlock Text="{Binding Chests}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Gold}" HorizontalAlignment="Right"/>
                                                        <TextBlock Text="chests seen" FontSize="10.5" Foreground="{DynamicResource TextFaint}" HorizontalAlignment="Right"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ==================================================== ODDS -->
                <ScrollViewer x:Name="OddsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,6,28,28">
                        <TextBlock Text="Odds calculator" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Try any number of chests. Every chest is an independent roll, so earlier bad luck doesn't make the next one more likely."
                                   Style="{StaticResource Hint}" FontSize="13" Margin="0,5,0,20"/>

                        <Border CornerRadius="14" Padding="18,14" Margin="0,0,0,16" Background="#14FFCD50" BorderBrush="#40FFCD50" BorderThickness="1">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE946;" Foreground="{DynamicResource Gold}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Opening more chests never guarantees the token" FontWeight="SemiBold" Margin="10,0,0,0"/>
                                </StackPanel>
                                <TextBlock x:Name="GuaranteeText" Style="{StaticResource Hint}" FontSize="12.5" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="19"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="0.7*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="NORMAL CHESTS" Style="{StaticResource Label}" Margin="0,0,0,7"/>
                                    <TextBox x:Name="CalcNormal" Style="{StaticResource Input}" Text="1000" TextChanged="Calc_TextChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="TREASURE HOURS CHESTS" Style="{StaticResource Label}" Margin="0,0,0,7"/>
                                    <TextBox x:Name="CalcTreasure" Style="{StaticResource Input}" Text="0" TextChanged="Calc_TextChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="BOOST" Style="{StaticResource Label}" Margin="0,0,0,7"/>
                                    <TextBox x:Name="CalcBoost" Style="{StaticResource Input}" Text="1.5" TextChanged="Calc_TextChanged"/>
                                </StackPanel>
                                <Button Grid.Column="6" Style="{StaticResource SecondaryButton}" VerticalAlignment="Bottom" Click="UseMyCount_Click" Padding="16,10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE77B;" VerticalAlignment="Center"/>
                                        <TextBlock Text="Use my count" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource HeroCard}" Margin="0,16,0,0">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="CHANCE OF AT LEAST ONE TOKEN" Style="{StaticResource Label}"/>
                                    <TextBlock x:Name="CalcChance" Text="0%" FontSize="52" FontWeight="Bold" Foreground="{DynamicResource Gold}" Margin="-2,6,0,0"/>
                                    <TextBlock x:Name="CalcOneIn" Text="" Style="{StaticResource Hint}" FontSize="13"/>
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="PER CHEST" Style="{StaticResource Label}" HorizontalAlignment="Right"/>
                                    <TextBlock Text="1 in 137,500" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="CalcBoostedPer" Text="1 in 91,667 in Treasure Hours" Style="{StaticResource Hint}" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <TextBlock Text="Chests needed for a ... chance" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="Chests per match" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBox x:Name="CalcPerMatch" Style="{StaticResource Input}" Text="6" Width="64" TextChanged="Calc_TextChanged"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1.4*"/>
                                        <ColumnDefinition Width="1.4*"/>
                                        <ColumnDefinition Width="1.2*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="CHANCE" Style="{StaticResource Label}"/>
                                    <TextBlock Grid.Column="1" Text="NORMAL CHESTS" Style="{StaticResource Label}"/>
                                    <TextBlock Grid.Column="2" Text="TREASURE HOURS CHESTS" Style="{StaticResource Label}"/>
                                    <TextBlock Grid.Column="3" Text="MATCHES" Style="{StaticResource Label}"/>
                                </Grid>
                                <ItemsControl x:Name="MilestoneList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,11">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1*"/>
                                                        <ColumnDefinition Width="1.4*"/>
                                                        <ColumnDefinition Width="1.4*"/>
                                                        <ColumnDefinition Width="1.2*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Target}" FontWeight="SemiBold" Foreground="{DynamicResource Gold}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Normal}"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Treasure}"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding Matches}" Foreground="{DynamicResource TextDim}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ==================================================== SETTINGS -->
                <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,6,28,28">
                        <TextBlock Text="Settings" Style="{StaticResource PageTitle}" Margin="0,0,0,20"/>

                        <!-- how chests are counted -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="How chests are counted" Style="{StaticResource CardTitle}" Margin="0,0,0,10"/>
                                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" FontSize="12.5"
                                           Text="After each match, Chest Tracker reads the replay Fortnite saves on your PC. The replay records every chest you opened, or broke open with a pickaxe or weapon while it was still unopened, and its exact type (normal, rare, sprite). Ammo boxes and chests that were already opened don't count. It never looks at your screen or touches the game, so anti-cheat has nothing to see. Your count goes up a few seconds after each match ends."/>
                                <Border Style="{StaticResource Divider}"/>

                                <Grid>
                                    <StackPanel Margin="0,0,190,0">
                                        <TextBlock x:Name="ReplayStatusText" Text="Not tracking" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="ReplayDetailText" Style="{StaticResource Hint}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Style="{StaticResource SecondaryButton}" Content="Open replay folder" HorizontalAlignment="Right"
                                            VerticalAlignment="Center" Click="OpenReplays_Click"/>
                                </Grid>
                                <Border Style="{StaticResource Divider}"/>

                                <StackPanel>
                                    <TextBlock Text="Keep replays switched on" FontWeight="SemiBold"/>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,0" TextWrapping="Wrap"
                                               Text="In Fortnite: Settings → Game → Replays → Record Battle Royale Replays: On. If you leave a match before it ends (closing the game), that match can't be read, because Fortnite only finishes the replay when the match is over."/>
                                </StackPanel>
                                <Border Style="{StaticResource Divider}"/>

                                <Grid>
                                    <StackPanel Margin="0,0,190,0">
                                        <TextBlock Text="Matches from before" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="ImportHint" Style="{StaticResource Hint}" Margin="0,3,0,0" TextWrapping="Wrap"
                                                   Text="Fortnite keeps your last 100 or so replays. Add the chests from matches that aren't in your count yet. Anything already counted during those matches is replaced by the exact replay count, so nothing is counted twice."/>
                                    </StackPanel>
                                    <Button x:Name="ImportButton" Style="{StaticResource SecondaryButton}" Content="Check older replays" HorizontalAlignment="Right"
                                            VerticalAlignment="Center" Click="ImportOlder_Click"/>
                                </Grid>
                                <TextBlock x:Name="ImportResult" Style="{StaticResource Hint}" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                                <Border Style="{StaticResource Divider}"/>

                                <CheckBox x:Name="AutoStartSwitch" Style="{StaticResource Switch}" Click="AutoStartSwitch_Click">
                                    <StackPanel>
                                        <TextBlock Text="Start tracking when the app opens" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </CheckBox>
                                <Border Style="{StaticResource Divider}"/>
                                <CheckBox x:Name="AutoTreasureSwitch" Style="{StaticResource Switch}" Click="AutoTreasureSwitch_Click">
                                    <StackPanel>
                                        <TextBlock Text="Automatic Treasure Hours" FontWeight="SemiBold"/>
                                        <TextBlock Text="Turns Treasure Hours on by itself at the times Epic announced, with that hour's boost. F9 still switches it on or off by hand."
                                                   Style="{StaticResource Hint}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </CheckBox>
                                <Border Style="{StaticResource Divider}"/>
                                <CheckBox x:Name="UpdatesSwitch" Style="{StaticResource Switch}" Click="UpdatesSwitch_Click">
                                    <StackPanel>
                                        <TextBlock Text="Tell me when there's a new version" FontWeight="SemiBold"/>
                                        <TextBlock Text="Checks this project's GitHub page now and then. Nothing about you is sent."
                                                   Style="{StaticResource Hint}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </CheckBox>
                                <Border Style="{StaticResource Divider}"/>

                                <TextBlock Text="RECENT MATCHES" Style="{StaticResource Label}" Margin="0,0,0,8"/>
                                <TextBlock x:Name="MatchesEmpty" Style="{StaticResource Hint}" Text="Matches show up here after they end."/>
                                <ItemsControl x:Name="MatchList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding When}" Foreground="{DynamicResource TextDim}" FontSize="12"/>
                                                <TextBlock Grid.Column="1" Text="{Binding What}" FontSize="12" TextWrapping="Wrap"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- overlay & sound -->
                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Overlay &amp; sound" Style="{StaticResource CardTitle}" Margin="0,0,0,16"/>
                                <CheckBox x:Name="BeepSwitch" Style="{StaticResource Switch}" Click="BeepSwitch_Click">
                                    <StackPanel>
                                        <TextBlock Text="Beep when a chest is counted" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </CheckBox>
                                <Border Style="{StaticResource Divider}"/>
                                <CheckBox x:Name="SummarySwitch" Style="{StaticResource Switch}" Click="SummarySwitch_Click">
                                    <StackPanel>
                                        <TextBlock Text="Match summary on the overlay" FontWeight="SemiBold"/>
                                        <TextBlock Text="After each match, e.g. &quot;+9 chests · 1 sprite · 2 broken open&quot; for a few seconds." Style="{StaticResource Hint}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                                <Border Style="{StaticResource Divider}"/>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Overlay opacity" FontWeight="SemiBold"/>
                                        <TextBlock Text="How see-through the overlay is." Style="{StaticResource Hint}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Border Style="{StaticResource SegmentHost}" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="Op60" Style="{StaticResource Segment}" GroupName="op" Content="60%" Tag="0.6" Checked="Opacity_Checked"/>
                                            <RadioButton x:Name="Op75" Style="{StaticResource Segment}" GroupName="op" Content="75%" Tag="0.75" Checked="Opacity_Checked"/>
                                            <RadioButton x:Name="Op92" Style="{StaticResource Segment}" GroupName="op" Content="90%" Tag="0.92" Checked="Opacity_Checked"/>
                                            <RadioButton x:Name="Op100" Style="{StaticResource Segment}" GroupName="op" Content="100%" Tag="1.0" Checked="Opacity_Checked"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Border Style="{StaticResource Divider}"/>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Overlay position" FontWeight="SemiBold"/>
                                        <TextBlock Text="Lost it off-screen? Put it back on the left side." Style="{StaticResource Hint}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Button Style="{StaticResource SecondaryButton}" Content="Reset position" HorizontalAlignment="Right"
                                            VerticalAlignment="Center" Click="ResetOverlay_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- background, reminders, squad -->
                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Background &amp; reminders" Style="{StaticResource CardTitle}" Margin="0,0,0,16"/>
                                <CheckBox x:Name="TraySwitch" Style="{StaticResource Switch}" Click="TraySwitch_Click">
                                    <StackPanel>
                                        <TextBlock Text="Keep running in the tray" FontWeight="SemiBold"/>
                                        <TextBlock Text="Closing the window leaves Chest Tracker counting in the system tray (by the clock). Click the chest icon to open it, right-click it to quit."
                                                   Style="{StaticResource Hint}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </CheckBox>
                                <Border Style="{StaticResource Divider}"/>
                                <CheckBox x:Name="StartupSwitch" Style="{StaticResource Switch}" Click="StartupSwitch_Click">
                                    <StackPanel>
                                        <TextBlock Text="Start with Windows" FontWeight="SemiBold"/>
                                        <TextBlock Text="Opens quietly in the tray when you turn on your PC, so you never forget to start it."
                                                   Style="{StaticResource Hint}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </CheckBox>
                                <Border Style="{StaticResource Divider}"/>
                                <CheckBox x:Name="RemindersSwitch" Style="{StaticResource Switch}" Click="RemindersSwitch_Click">
                                    <StackPanel>
                                        <TextBlock Text="Treasure Hour reminders" FontWeight="SemiBold"/>
                                        <TextBlock Text="A Windows notification 10 minutes before each Treasure Hour, and when it starts."
                                                   Style="{StaticResource Hint}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </CheckBox>
                                <Border Style="{StaticResource Divider}"/>
                                <CheckBox x:Name="SquadTabSwitch" Style="{StaticResource Switch}" Click="SquadTabSwitch_Click">
                                    <StackPanel>
                                        <TextBlock Text="Squad totals" FontWeight="SemiBold"/>
                                        <TextBlock Text="Adds a Squad tab, where you can turn on tracking of your teammates' chests and finds."
                                                   Style="{StaticResource Hint}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <!-- overlay look -->
                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Overlay look" Style="{StaticResource CardTitle}" Margin="0,0,0,16"/>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Size" FontWeight="SemiBold"/>
                                        <TextBlock Text="How big the overlay is on screen." Style="{StaticResource Hint}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <StackPanel x:Name="SizeSegments" Orientation="Horizontal">
                                            <RadioButton Style="{StaticResource Segment}" GroupName="ovsize" Content="70%" Tag="0.7" Checked="OverlaySize_Checked"/>
                                            <RadioButton Style="{StaticResource Segment}" GroupName="ovsize" Content="85%" Tag="0.85" Checked="OverlaySize_Checked"/>
                                            <RadioButton Style="{StaticResource Segment}" GroupName="ovsize" Content="100%" Tag="1" Checked="OverlaySize_Checked"/>
                                            <RadioButton Style="{StaticResource Segment}" GroupName="ovsize" Content="120%" Tag="1.2" Checked="OverlaySize_Checked"/>
                                            <RadioButton Style="{StaticResource Segment}" GroupName="ovsize" Content="140%" Tag="1.4" Checked="OverlaySize_Checked"/>
                                            <RadioButton Style="{StaticResource Segment}" GroupName="ovsize" Content="170%" Tag="1.7" Checked="OverlaySize_Checked"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Border Style="{StaticResource Divider}"/>
                                <CheckBox x:Name="OvCompact" Style="{StaticResource Switch}" Click="OverlayLook_Click">
                                    <StackPanel>
                                        <TextBlock Text="Compact" FontWeight="SemiBold"/>
                                        <TextBlock Text="A smaller, narrower panel with less text." Style="{StaticResource Hint}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                                <Border Style="{StaticResource Divider}"/>
                                <TextBlock Text="SHOW ON THE OVERLAY" Style="{StaticResource Label}" Margin="0,0,0,10"/>
                                <UniformGrid Columns="2">
                                    <CheckBox x:Name="OvCount" Style="{StaticResource Switch}" Click="OverlayLook_Click" Margin="0,0,16,10"><TextBlock Text="Chest count" VerticalAlignment="Center"/></CheckBox>
                                    <CheckBox x:Name="OvChance" Style="{StaticResource Switch}" Click="OverlayLook_Click" Margin="0,0,0,10"><TextBlock Text="Token chance" VerticalAlignment="Center"/></CheckBox>
                                    <CheckBox x:Name="OvOneIn" Style="{StaticResource Switch}" Click="OverlayLook_Click" Margin="0,0,16,10"><TextBlock Text="&quot;1 in …&quot; under the chance" VerticalAlignment="Center"/></CheckBox>
                                    <CheckBox x:Name="OvSession" Style="{StaticResource Switch}" Click="OverlayLook_Click" Margin="0,0,0,10"><TextBlock Text="This session" VerticalAlignment="Center"/></CheckBox>
                                    <CheckBox x:Name="OvToday" Style="{StaticResource Switch}" Click="OverlayLook_Click" Margin="0,0,16,10"><TextBlock Text="Today's chests" VerticalAlignment="Center"/></CheckBox>
                                    <CheckBox x:Name="OvNextHour" Style="{StaticResource Switch}" Click="OverlayLook_Click" Margin="0,0,0,10"><TextBlock Text="Next Treasure Hour" VerticalAlignment="Center"/></CheckBox>
                                    <CheckBox x:Name="OvStatus" Style="{StaticResource Switch}" Click="OverlayLook_Click" Margin="0,0,16,10"><TextBlock Text="Tracking status line" VerticalAlignment="Center"/></CheckBox>
                                    <CheckBox x:Name="OvTreasure" Style="{StaticResource Switch}" Click="OverlayLook_Click" Margin="0,0,0,10"><TextBlock Text="Treasure Hours badge" VerticalAlignment="Center"/></CheckBox>
                                    <CheckBox x:Name="OvHint" Style="{StaticResource Switch}" Click="OverlayLook_Click" Margin="0,0,16,10"><TextBlock Text="Move/lock hint" VerticalAlignment="Center"/></CheckBox>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- colours -->
                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <TextBlock Text="Colours" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                                    <Button Style="{StaticResource SecondaryButton}" Content="Back to the original colours" HorizontalAlignment="Right" Click="ColoursReset_Click" Padding="12,6"/>
                                </Grid>
                                <TextBlock Text="ACCENT" Style="{StaticResource Label}" Margin="0,0,0,8"/>
                                <WrapPanel x:Name="AccentSwatches" Margin="0,0,0,14"/>
                                <TextBlock Text="BACKGROUND" Style="{StaticResource Label}" Margin="0,0,0,8"/>
                                <WrapPanel x:Name="BackgroundSwatches" Margin="0,0,0,14"/>
                                <TextBlock Text="EXACT COLOURS (#RRGGBB)" Style="{StaticResource Label}" Margin="0,0,0,8"/>
                                <UniformGrid x:Name="ColourInputs" Columns="3"/>
                                <TextBlock x:Name="ColourResult" Style="{StaticResource Hint}" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Text="Changes show straight away and are saved. Type a colour code and press Enter."/>
                            </StackPanel>
                        </Border>

                        <!-- data -->
                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Your data" Style="{StaticResource CardTitle}" Margin="0,0,0,16"/>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Count file" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="DataPathText" Style="{StaticResource Hint}" Margin="0,3,280,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Style="{StaticResource SecondaryButton}" Content="Open folder" Click="OpenFolder_Click"/>
                                        <Button Style="{StaticResource DangerButton}" Content="Reset count" Margin="8,0,0,0" Click="ResetCount_Click"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- about -->
                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{DynamicResource ChestIcon}" Width="36" Height="36" VerticalAlignment="Center"/>
                                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="AboutTitle" Text="Chest Tracker 2.0" FontWeight="SemiBold" FontSize="14"/>
                                        <TextBlock Text="Coded with Claude Opus 5.5 · Open source (MIT) · Not affiliated with Epic Games" Style="{StaticResource Hint}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="GitHub_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="View on GitHub"/>
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8A7;" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="11"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
